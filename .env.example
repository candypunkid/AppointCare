APP_NAME=AppointCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kathmandu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appointcare
DB_USERNAME=root
DB_PASSWORD=

# Session / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

# Twilio
# TWILIO_SID must be your Twilio Account SID
TWILIO_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER must be a Twilio-provisioned number (NOT a personal mobile).
# Twilio does not sell Nepal (+977) numbers, so use a trial US/UK number as "From".
TWILIO_PHONE_NUMBER=
# Public URL Twilio can reach (your ngrok URL in local testing), e.g. https://abc123.ngrok.io
TWILIO_WEBHOOK_BASE_URL=https://appointcare.local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to true to use the canned mock responses without an API key
AI_MOCK=false

# AppointCare
APPOINTCARE_ADMIN_PHONE=
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
SLOT_DURATION_MINUTES=60
MAX_SLOTS_PER_SLOT=1
REMINDER_24H_ENABLED=true
REMINDER_2H_ENABLED=true
